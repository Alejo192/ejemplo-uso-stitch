# Copia este archivo como ".env" y completa tus valores reales.

# Panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# WhatsApp de contacto, solo dígitos con código de país (Colombia: 57XXXXXXXXXX)
WHATSAPP=573001234567

# Notificación por correo de cada pedido nuevo (opcional, deja vacío para desactivar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=

# Pon en 1 solo si despliegas detrás de un proxy inverso (nginx, etc.)
TRUST_PROXY=0
